<UserControl x:Class="TemperatureCalibratorUtil.Chart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TemperatureCalibratorUtil"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" 
             xmlns:vm="clr-namespace:TemperatureCalibratorUtil.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ChartViewModel}">
    <Border BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{x:Static local:AppColors.OkBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="BorderBrush" Value="{x:Static local:AppColors.ErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Content="{Binding Name}"/>
            <lvc:CartesianChart
            MinHeight="150"
            Grid.Row="1"
            AnimationsSpeed="0"
            SyncContext="{Binding Sync}"
            >
                <lvc:CartesianChart.Series>
                    <lvc:SeriesCollection>
                        <lvc:XamlLineSeries
                        Values="{Binding Values}"
                        Fill="{x:Null}"
                        GeometryFill="{x:Null}"
                        GeometryStroke="{x:Null}"
                        Stroke="{lvc:SolidColorPaint Color='98b8da', StrokeWidth='1'}"
                    />
                    </lvc:SeriesCollection>
                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.XAxes>
                    <lvc:AxesCollection>
                        <lvc:XamlDateTimeAxis
                        Interval="0:0:1"
                        DateFormatter="{Binding LabelsFormatter}"
                        AnimationsSpeed="0"
                        SeparatorsPaint="{lvc:SolidColorPaint Color='64B4B4B4'}"
                        CustomSeparators="{Binding Separators}"/>
                    </lvc:AxesCollection>
                </lvc:CartesianChart.XAxes>
            </lvc:CartesianChart>
            <TextBlock Grid.Row="2" HorizontalAlignment="Right">
            Current value: <TextBlock Text="{Binding CurrentValue}"/>
        </TextBlock>
        </Grid>
    </Border>
</UserControl>