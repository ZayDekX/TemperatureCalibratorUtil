<UserControl x:Class="TemperatureCalibratorUtil.Components.ConnectionSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TemperatureCalibratorUtil.Components" 
             xmlns:vm="clr-namespace:TemperatureCalibratorUtil.ViewModel"
             xmlns:root="clr-namespace:TemperatureCalibratorUtil"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ConnectionControlViewModel}">
    <Grid Grid.Row="0">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label     Grid.Row="0" Grid.Column="0" Content="Host"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host}" IsEnabled="{Binding IsNotRunning}"/>
        <Label     Grid.Row="1" Grid.Column="0" Content="Port"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" IsEnabled="{Binding IsNotRunning}"/>
        <TextBlock Margin="0,8" Grid.Row="2">Status: <TextBlock Text="{Binding ConnectionStatus}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{x:Static root:AppColors.OkBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                                <Setter Property="Foreground" Value="{x:Static root:AppColors.ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </TextBlock>
        <Button Grid.Row="3" Grid.ColumnSpan="2" Command="{Binding ToggleConnectionCommand}" Content="{Binding ToggleConnectionText}"/>
    </Grid>
</UserControl>
