<UserControl x:Class="TemperatureCalibratorUtil.Components.SystemSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TemperatureCalibratorUtil.Components" 
             xmlns:vm="clr-namespace:TemperatureCalibratorUtil.ViewModel"
             xmlns:root="clr-namespace:TemperatureCalibratorUtil"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:SystemControlViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="T_target"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetTemperature, StringFormat=F1}"/>
        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding TargetTemperature}"/>
        <TextBlock Grid.Row="2" Grid.RowSpan="2" Text="{Binding Stability}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{x:Static root:AppColors.OkBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStable}" Value="False">
                            <Setter Property="Foreground" Value="{x:Static root:AppColors.ErrorBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button Grid.Row="4" Grid.ColumnSpan="2" Command="{Binding StartButtonCommand}" Content="{Binding StartButtonText}"/>
    </Grid>
</UserControl>
